# Copie para .env (cp .env.example .env) e ajuste os valores.
# Este é o único arquivo de configuração: Vite, API e docker-compose leem daqui.
# Em produção: chmod 600 .env (contém segredos). Passo a passo em docs/DEPLOY.md.

# --- Frontend ---
# Variáveis VITE_ vão para o código do navegador: nunca coloque segredos nelas.
# Em produção, mudou? docker compose build web && docker compose up -d
VITE_EMAIL_SOLICITAR_ACESSO=solicitar-acesso@exemplo.com

# --- Banco de dados ---
# Senha só com letras e números (vai dentro de uma URL de conexão). Gere com: openssl rand -hex 24
POSTGRES_USER=epi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=epi_system
# Só para desenvolvimento (API rodando fora do Docker). No docker-compose.yml a URL é montada sozinha.
DATABASE_URL=postgresql://epi:troque-esta-senha@localhost:5432/epi_system

# --- API ---
API_PORT=3000

# Endereço que os usuários digitam no navegador (usado nos links dos e-mails de convite e de senha).
# Dev: http://localhost:5173 | Produção: https://endereco-da-vm (ou http://IP, se ainda sem HTTPS)
APP_URL=http://localhost:5173

# Segredo que assina as sessões. Gere um novo para cada ambiente: openssl rand -base64 48
# Trocar este valor desloga todo mundo.
JWT_SEGREDO=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# true só quando o sistema for acessado por HTTPS (senão o navegador descarta o cookie de sessão)
COOKIE_SECURE=false

# Quantos proxies há na frente da API: 1 = só nginx (ou Vite em dev); 2 = Caddy (HTTPS) + nginx
TRUST_PROXY=1

# EmailJS (chamado pela API). Em desenvolvimento pode ficar vazio: os e-mails aparecem no console da API.
# Obrigatório em produção. No painel do EmailJS (Account > Security) ligue:
#   "Allow EmailJS API for non-browser applications" e "Use Private Key"
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Template atual do convite: {{nome}}, {{email}}, {{departamento}}, {{role}}, {{convite_url}}; destinatário {{to_email}}
EMAILJS_TEMPLATE_CONVITE=
# Template novo: {{nome}}, {{redefinir_url}}, {{validade}}; destinatário {{to_email}}
EMAILJS_TEMPLATE_REDEFINIR_SENHA=

# Primeiro administrador, criado pelo seed só se ainda não existir nenhum admin.
# Depois do primeiro login, troque a senha pelo sistema e APAGUE ADMIN_INICIAL_SENHA daqui.
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_EMAIL=admin@exemplo.com
ADMIN_INICIAL_SENHA=troque-esta-senha

# --- Produção (docker-compose.yml) ---
# Porta publicada pelo nginx. Sem HTTPS: 80. Com o Caddy na frente: 127.0.0.1:8080
WEB_PORTA=80
# HTTPS com o Caddy na própria VM: COMPOSE_PROFILES=https liga o serviço "caddy" em todo comando docker compose
COMPOSE_PROFILES=
# Endereço do site e modo do certificado (ver Caddyfile)
SITE_ENDERECO=
CADDY_TLS=
