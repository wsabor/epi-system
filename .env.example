# Copie para .env (cp .env.example .env) e ajuste os valores.
# Este é o único arquivo de configuração: Vite, API e docker-compose leem daqui.

# --- Frontend ---
# Variáveis VITE_ vão para o código do navegador: nunca coloque segredos nelas.
VITE_EMAIL_SOLICITAR_ACESSO=solicitar-acesso@exemplo.com

# Firebase: só enquanto o frontend não for migrado (remover na Fase 5)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Banco de dados ---
POSTGRES_USER=epi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=epi_system
DATABASE_URL=postgresql://epi:troque-esta-senha@localhost:5432/epi_system

# --- API ---
API_PORT=3000

# Primeiro administrador, criado por `npm run db:seed` só se ainda não existir nenhum admin.
# Depois do primeiro login, troque a senha e pode apagar ADMIN_INICIAL_SENHA daqui.
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_EMAIL=admin@exemplo.com
ADMIN_INICIAL_SENHA=troque-esta-senha
