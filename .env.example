# EPI System — configuração. Copie para .env (cp .env.example .env) e ajuste.
# O Vite, a API e o docker-compose leem este mesmo arquivo.
# Produção: siga o docs/DEPLOY.md e proteja o arquivo (chmod 600 .env).

# ── Frontend ───────────────────────────────────────────────
# Vai para o código do navegador: nada secreto aqui.
VITE_EMAIL_SOLICITAR_ACESSO=solicitar-acesso@exemplo.com

# ── Banco de dados ─────────────────────────────────────────
# Senha só com letras e números. Gere com: openssl rand -hex 24
POSTGRES_USER=epi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=epi_system
# Só para desenvolvimento (API fora do Docker). Em produção o compose monta a conexão.
DATABASE_URL=postgresql://epi:troque-esta-senha@localhost:5432/epi_system

# ── API ────────────────────────────────────────────────────
API_PORT=3000
# Endereço que as pessoas digitam no navegador (vai nos links dos e-mails).
APP_URL=http://localhost:5173
# Assina as sessões; trocar desloga todo mundo. Gere com: openssl rand -base64 48
JWT_SEGREDO=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# true só com HTTPS (senão o navegador descarta o cookie de sessão).
COOKIE_SECURE=false
# Proxies na frente da API: 1 = nginx (ou Vite em dev); 2 = Caddy + nginx.
TRUST_PROXY=1

# ── E-mail (EmailJS, enviado pela API) ─────────────────────
# Vazio = os e-mails aparecem só no console da API (bom para desenvolvimento).
# Obrigatório em produção. Painel do EmailJS → Account → Security: ligar
# "Allow EmailJS API for non-browser applications" e "Use Private Key".
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Convite: {{nome}} {{email}} {{departamento}} {{role}} {{convite_url}} — destinatário {{to_email}}
EMAILJS_TEMPLATE_CONVITE=
# Redefinição de senha: {{nome}} {{redefinir_url}} {{validade}} — destinatário {{to_email}}
EMAILJS_TEMPLATE_REDEFINIR_SENHA=

# ── Primeiro administrador ─────────────────────────────────
# Criado pelo seed só se ainda não houver admin. Depois do 1º login, troque a senha
# pelo sistema e apague ADMIN_INICIAL_SENHA daqui.
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_EMAIL=admin@exemplo.com
ADMIN_INICIAL_SENHA=troque-esta-senha

# ── Só produção (docker-compose.yml) ───────────────────────
# Porta do nginx. Sem HTTPS: 80. Com o Caddy na frente: 127.0.0.1:8080
WEB_PORTA=80
# HTTPS com o Caddy (docs/DEPLOY.md, seção 6): COMPOSE_PROFILES=https
COMPOSE_PROFILES=
SITE_ENDERECO=
CADDY_TLS=
